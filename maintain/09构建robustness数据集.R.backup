# ============================================================
# SSP2 数据预处理 - 步骤9: 构建 Robustness 数据集（加速版）
#
# 功能:
#   对每个药物表达谱，用 5 种方法计算自环排名，
#   聚合为 robustness 指标
#
# 策略:
#   - 复用 R/SS.R 核心算法
#   - 使用 mclapply 并行
#   - 中间结果存 tmp_files，最终合并
# ============================================================

library(dplyr)
library(tidyr)
library(parallel)

source("R/SS.R")  # 五种算法

# ============================================================
# 配置
# ============================================================
drug_dir     <- "data_preload/drugexp/"
robust_dir   <- "data_preload/robustness/"
tmp_dir      <- file.path(robust_dir, "tmp_files/")

dir.create(robust_dir, showWarnings = FALSE, recursive = TRUE)
dir.create(tmp_dir, showWarnings = FALSE, recursive = TRUE)

# ============================================================
# 函数: 对单个化合物计算自环排名
# ============================================================
.S <- function(scores) {
  p <- max(scores); q <- min(scores)
  ifelse(scores == 0, 0, ifelse(scores > 0, scores / p, -scores / q))
}

get_rank_sp <- function(cpname, refMatrix, threshold, topn) {
  sig_input <- refMatrix %>%
    dplyr::select(all_of(cpname)) %>%
    tibble::rownames_to_column(var = "Gene") %>%
    tidyr::pivot_longer(!Gene, names_to = "compounds", values_to = "log2FC") %>%
    dplyr::arrange(log2FC)
  
  sig_up <- sig_input %>% filter(log2FC > threshold) %>%
    arrange(desc(log2FC)) %>% pull(Gene)
  sig_dn <- sig_input %>% filter(log2FC < -threshold) %>%
    arrange(log2FC) %>% pull(Gene)
  
  # 五种方法
  res_xsum <- XSumScore(refMatrix, queryUp = head(sig_up, topn),
                        queryDown = head(sig_dn, topn),
                        topN = nrow(refMatrix)/2)
  res_ks   <- KSScore(refMatrix, queryUp = head(sig_up, topn),
                      queryDown = head(sig_dn, topn))
  res_gs   <- GSEAweight1Score(refMatrix, queryUp = head(sig_up, topn),
                                queryDown = head(sig_dn, topn))
  res_zh   <- ZhangScore(refMatrix, queryUp = head(sig_up, topn),
                          queryDown = head(sig_dn, topn))
  
  sig_both <- bind_rows(
    sig_input %>% filter(log2FC < -threshold) %>% slice_min(log2FC, n = topn),
    sig_input %>% filter(log2FC > threshold) %>% slice_max(log2FC, n = topn)
  )
  res_cos  <- XCosScore(refMatrix, query = setNames(sig_both$log2FC, sig_both$Gene),
                         topN = nrow(refMatrix)/2)
  
  get_rank <- function(res_tb) {
    if (is.null(res_tb) || nrow(res_tb) == 0) return(NA_character_)
    res_tb %>% tibble::rownames_to_column("name") %>%
      arrange(desc(Scale_score)) %>% slice(1) %>% pull(name)
  }
  get_diff <- function(res_tb) {
    if (is.null(res_tb) || nrow(res_tb) < 2) return(0)
    ranked <- res_tb %>% tibble::rownames_to_column("name") %>%
      arrange(desc(Scale_score))
    if (nrow(ranked) >= 2) ranked[1, 2] - ranked[2, 2] else 0
  }
  
  res_rank <- c(
    get_rank(res_xsum %>% mutate(Scale_score = .S(Score))),
    get_rank(res_ks %>% mutate(Scale_score = .S(Score))),
    get_rank(res_gs %>% mutate(Scale_score = .S(Score))),
    get_rank(res_zh %>% mutate(Scale_score = .S(Score))),
    get_rank(res_cos %>% mutate(Scale_score = .S(Score)))
  )
  res_diff <- c(
    get_diff(res_xsum %>% mutate(Scale_score = .S(Score))),
    get_diff(res_ks %>% mutate(Scale_score = .S(Score))),
    get_diff(res_gs %>% mutate(Scale_score = .S(Score))),
    get_diff(res_zh %>% mutate(Scale_score = .S(Score))),
    get_diff(res_cos %>% mutate(Scale_score = .S(Score)))
  )
  
  return(data.frame(
    Xsum1 = res_rank[1], CMap1 = res_rank[2], GSEA1 = res_rank[3],
    ZhangScore1 = res_rank[4], Cos1 = res_rank[5],
    Xsum2 = res_diff[1], CMap2 = res_diff[2], GSEA2 = res_diff[3],
    ZhangScore2 = res_diff[4], Cos2 = res_diff[5],
    stringsAsFactors = FALSE
  ))
}

get_rb <- function(topn, refMatrix, threshold, file_input_string, tmp_dir) {
  colnames(refMatrix) <- 1:ncol(refMatrix)
  
  res1 <- mclapply(as.character(1:ncol(refMatrix)), get_rank_sp,
                    refMatrix = refMatrix, threshold = threshold, topn = topn,
                    mc.cores = min(64, detectCores() - 2)) %>%
    bind_rows() %>%
    tibble::rownames_to_column(var = "input_id") %>%
    type.convert(as.is = TRUE)
  
  save(res1, file = file.path(tmp_dir, paste0(file_input_string, "_", topn, ".rdata")))
  
  res <- res1 %>%
    summarise(
      xsum       = cor(as.numeric(input_id), as.numeric(Xsum1)) * mean(Xsum2) / sd(Xsum2),
      cmap       = cor(as.numeric(input_id), as.numeric(CMap1)) * mean(CMap2) / sd(CMap2),
      gsea       = cor(as.numeric(input_id), as.numeric(GSEA1)) * mean(GSEA2) / sd(GSEA2),
      zhangscore = cor(as.numeric(input_id), as.numeric(ZhangScore1)) * mean(ZhangScore2) / sd(ZhangScore2),
      cos        = cor(as.numeric(input_id), as.numeric(Cos1)) * mean(Cos2) / sd(Cos2)
    ) %>% mutate(topn = topn)
  
  return(res)
}

# ============================================================
# 主循环
# ============================================================
file_list <- list.files(drug_dir, pattern = "\\.rdata$")

# 按文件大小降序（大文件先处理）
file_sizes <- sapply(file.path(drug_dir, file_list), file.size)
file_list  <- file_list[order(file_sizes, decreasing = TRUE)]

cat(sprintf("待处理文件数: %d\n", length(file_list)))

for (f in file_list) {
  out_path <- file.path(robust_dir, f)
  
  if (f %in% list.files(robust_dir)) {
    cat(sprintf("[SKIP] %s (已存在)\n", f))
    next
  }
  
  cat(sprintf("\n[PROCESS] %s\n", f))
  
  tryCatch({
    load(file.path(drug_dir, f))  # 加载 exp_LINCS2020
    
    res_topn <- lapply(seq(10, 90, 10), get_rb,
                        refMatrix = exp_LINCS2020,
                        threshold = 0.585,
                        file_input_string = f,
                        tmp_dir = tmp_dir)
    
    res_topn2 <- do.call(rbind, res_topn)
    save(res_topn2, file = out_path)
    cat(sprintf("  [DONE] %s\n", out_path))
    
    rm(exp_LINCS2020, sig_LINCS2020); gc()
  }, error = function(e) {
    cat(sprintf("  [ERROR] %s: %s\n", f, e$message))
  })
}

cat("\nRobustness 数据集构建完成!\n")
